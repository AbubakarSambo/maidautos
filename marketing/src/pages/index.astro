---
const APP_URL = "https://app.maidautos.com"

const steps = [
  { n: '1', title: 'Search', desc: 'Enter your origin city, destination, and travel date to see available trips.' },
  { n: '2', title: 'Choose Your Seat', desc: 'Pick your seat on the visual seat map and select your preferred stops.' },
  { n: '3', title: 'Pay & Travel', desc: 'Pay securely via Paystack or cash. Receive your e-ticket instantly.' },
]

const featuredRoutes = [
  { from: 'Abuja', to: 'Maiduguri', tag: null },
  { from: 'Abuja', to: 'Kaduna', tag: null },
  { from: 'Kaduna', to: 'Maiduguri', tag: 'HIGH FREQUENCY' },
]

const moreRoutes = [
  { from: 'Abuja', to: 'Kano' },
  { from: 'Kano', to: 'Maiduguri' },
  { from: 'Kaduna', to: 'Kano' },
]

const features = [
  { title: 'Secure Payments', desc: 'Powered by Paystack. Your payment is safe and protected by industry-leading security.' },
  { title: 'Live Tracking', desc: 'Know exactly where your bus is on its journey with our real-time GPS tracking system.' },
  { title: 'Instant Tickets', desc: 'No queues. Your e-ticket is delivered immediately to your email and WhatsApp.' },
  { title: 'Choose Your Seat', desc: 'Pick your preferred seat visually before you pay. Sit exactly where you want.' },
]
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MaidAutos | Intercity Travel Made Simple</title>
  <meta name="description" content="Book intercity bus tickets across Nigeria. Abuja, Kaduna, Maiduguri and more. Safe, comfortable, on time." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap" rel="stylesheet" />
  <style>
    @import "tailwindcss";
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .font-display { font-family: 'Manrope', sans-serif; }
  </style>
</head>
<body class="bg-white text-gray-900">

  <!-- Nav -->
  <header class="fixed top-0 left-0 w-full z-50 bg-white border-b border-gray-200">
    <nav class="flex items-center justify-between px-6 lg:px-16 max-w-6xl mx-auto h-16">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 bg-green-700 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8M8 11h8M8 15h4m-9 5h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        </div>
        <span class="font-display font-bold text-lg text-green-800">MaidAutos</span>
      </div>
      <div class="hidden md:flex items-center gap-8">
        <a href="#how-it-works" class="text-gray-600 font-medium hover:text-green-700 transition-colors text-sm">How It Works</a>
        <a href="#why-us" class="text-gray-600 font-medium hover:text-green-700 transition-colors text-sm">Why Us</a>
        <a href={APP_URL} class="text-gray-600 font-medium hover:text-green-700 transition-colors text-sm">Sign In</a>
        <a href={APP_URL} class="bg-green-700 text-white px-6 py-2 rounded-full font-bold text-sm hover:bg-green-800 transition-colors">Register</a>
      </div>
      <button class="md:hidden p-2 text-gray-600" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
    </nav>
  </header>

  <main class="pt-16">

    <!-- Hero -->
    <section class="relative bg-gradient-to-br from-green-900 to-green-700 text-white px-6 lg:px-16 pt-20 pb-32 overflow-hidden">
      <div class="relative max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 mb-8">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1l2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.13l-4.77 2.58.91-5.32L2.27 6.62l5.34-.78L10 1z" clip-rule="evenodd" /></svg>
          <span class="text-xs font-bold uppercase tracking-widest text-green-100">Premium Intercity Transport</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-extrabold mb-6 leading-tight">
          Travel Between Cities<br />
          <span class="text-green-300">With Confidence</span>
        </h1>
        <p class="text-green-200 text-lg lg:text-xl mb-10 max-w-xl mx-auto">Book your intercity bus ticket online in minutes. Pay securely, receive your ticket instantly, and travel comfortably.</p>
        <div class="flex flex-col md:flex-row gap-4 justify-center items-center">
          <a href={APP_URL} class="inline-flex items-center gap-2 bg-white text-green-800 px-8 py-4 rounded-2xl text-lg font-bold hover:bg-green-50 transition-colors shadow-lg">
            Book Your Ticket
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <div class="flex -space-x-3">
            {['A', 'B', 'C'].map((letter) => (
              <div class="w-11 h-11 rounded-full border-2 border-white bg-green-600 flex items-center justify-center text-sm font-bold text-white">{letter}</div>
            ))}
            <div class="w-11 h-11 rounded-full border-2 border-white bg-green-300 flex items-center justify-center text-green-900 font-bold text-xs">+10k</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking widget -->
    <section class="max-w-5xl mx-auto px-6 lg:px-0 -mt-16 relative z-20">
      <div class="bg-white rounded-2xl shadow-2xl p-6 md:p-8 grid grid-cols-1 md:grid-cols-4 gap-4 items-end border border-gray-100">
        <div class="space-y-2">
          <label class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-gray-500">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            From
          </label>
          <select class="w-full bg-gray-50 border border-gray-200 rounded-lg p-3 text-sm focus:ring-2 focus:ring-green-600 focus:border-transparent">
            <option>Select City</option>
            <option>Abuja</option>
            <option>Maiduguri</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-gray-500">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
            To
          </label>
          <select class="w-full bg-gray-50 border border-gray-200 rounded-lg p-3 text-sm focus:ring-2 focus:ring-green-600 focus:border-transparent">
            <option>Select Destination</option>
            <option>Kaduna</option>
            <option>Kano</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-gray-500">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            Date
          </label>
          <input type="date" class="w-full bg-gray-50 border border-gray-200 rounded-lg p-3 text-sm focus:ring-2 focus:ring-green-600 focus:border-transparent" />
        </div>
        <button class="bg-green-700 text-white rounded-lg py-3.5 font-bold hover:bg-green-800 transition-colors flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          Search Trips
        </button>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="px-6 lg:px-16 py-20 max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-2">How It Works</h2>
      <p class="text-gray-500 text-center mb-16">Three simple steps to your seat</p>
      <div class="grid lg:grid-cols-3 gap-12 relative">
        <div class="hidden lg:block absolute top-7 left-24 right-24 h-0.5 bg-gray-200 -z-0"></div>
        {steps.map(({ n, title, desc }) => (
          <div class="relative z-10 flex flex-col items-center text-center group">
            <div class="w-14 h-14 rounded-2xl bg-white shadow-md border border-gray-200 flex items-center justify-center mb-6 text-xl font-black group-hover:bg-green-700 group-hover:text-white group-hover:border-green-700 transition-all">{n}</div>
            <h3 class="text-lg font-bold mb-2">{title}</h3>
            <p class="text-gray-500 px-4">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Routes -->
    <section class="bg-gray-50 px-6 lg:px-16 py-20">
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12 gap-4">
          <div>
            <h2 class="text-3xl font-bold mb-2">Popular Routes</h2>
            <p class="text-gray-500">We cover major routes across Northern Nigeria</p>
          </div>
          <a href={APP_URL} class="text-green-700 font-bold flex items-center gap-1.5 hover:underline text-sm">
            View All Routes
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          {featuredRoutes.map(({ from, to, tag }) => (
            <a href={APP_URL} class="group p-6 rounded-2xl border border-gray-200 hover:border-green-300 hover:shadow-lg transition-all bg-white">
              <div class="flex justify-between items-start mb-8">
                <div class="flex flex-col gap-1">
                  <span class="text-xs font-bold text-gray-400 uppercase">Origin</span>
                  <span class="text-lg font-bold">{from}</span>
                </div>
                <div class="flex items-center justify-center w-10 h-10 rounded-full bg-green-50 text-green-700 flex-shrink-0">
                  <svg class="w-5 h-5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
                </div>
                <div class="flex flex-col gap-1 text-right">
                  <span class="text-xs font-bold text-gray-400 uppercase">Destination</span>
                  <span class="text-lg font-bold">{to}</span>
                </div>
              </div>
              <div class="flex justify-between items-center mt-4 pt-4 border-t border-gray-100">
                <span class="text-green-700 font-bold text-sm">Book Now</span>
                {tag && <span class="text-xs bg-green-50 text-green-700 px-2 py-1 rounded font-bold">{tag}</span>}
              </div>
            </a>
          ))}
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {moreRoutes.map(({ from, to }) => (
            <a href={APP_URL} class="p-4 border border-gray-200 rounded-xl flex items-center justify-between hover:bg-white transition-colors bg-white">
              <span class="font-bold text-sm">{from} → {to}</span>
              <svg class="w-5 h-5 text-green-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="why-us" class="px-6 lg:px-16 py-20 max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-2">Why MaidAutos?</h2>
      <p class="text-gray-500 text-center mb-16">The gold standard for intercity travel in Nigeria</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {features.map(({ title, desc }) => (
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200 hover:shadow-lg transition-all">
            <div class="w-12 h-12 bg-green-50 text-green-700 rounded-full flex items-center justify-center mb-6">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h3 class="text-lg font-bold mb-2">{title}</h3>
            <p class="text-gray-500 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-green-700 text-white px-6 py-20 text-center relative overflow-hidden">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">Ready to travel?</h2>
      <p class="text-green-200 mb-10 max-w-xl mx-auto">Join thousands of passengers who book with MaidAutos every day for a safer, faster, and more convenient travel experience.</p>
      <a href={APP_URL} class="inline-flex items-center gap-2 bg-white text-green-700 px-10 py-4 rounded-full text-lg font-bold hover:bg-green-50 transition-colors shadow-lg">
        Book Your Ticket Now
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </section>

  </main>

  <!-- Footer -->
  <footer class="bg-green-950 text-green-100">
    <div class="max-w-5xl mx-auto px-6 lg:px-16 py-16 grid grid-cols-1 md:grid-cols-4 gap-10">
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 bg-green-600 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8M8 11h8M8 15h4m-9 5h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
          </div>
          <span class="font-display font-bold text-lg text-white">MaidAutos</span>
        </div>
        <p class="text-sm text-green-300/80 leading-relaxed">Providing high-trust, safe, and reliable intercity transport services across Nigeria using digital-first solutions.</p>
      </div>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-green-400 mb-5">Company</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="#why-us" class="hover:text-white transition-colors">Why Choose Us</a></li>
          <li><a href="#how-it-works" class="hover:text-white transition-colors">How It Works</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Popular Routes</a></li>
          <li><a href="#" class="hover:text-white transition-colors">About Us</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-green-400 mb-5">Account</h4>
        <ul class="space-y-3 text-sm">
          <li><a href={APP_URL} class="hover:text-white transition-colors">Create Account</a></li>
          <li><a href={APP_URL} class="hover:text-white transition-colors">Sign In</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="hover:text-white transition-colors">Terms of Service</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-xs font-bold uppercase tracking-widest text-green-400 mb-5">Contact</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="mailto:help@maidautos.com" class="hover:text-white transition-colors">help@maidautos.com</a></li>
          <li><a href="tel:+2348000000000" class="hover:text-white transition-colors">+234 800 000 0000</a></li>
          <li class="text-green-300/60">Main Terminal, Abuja, Nigeria</li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 py-6">
      <div class="max-w-5xl mx-auto px-6 lg:px-16 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-green-300/60">
        <p>© {new Date().getFullYear()} MaidAutos. All rights reserved.</p>
        <div class="flex gap-6">
          <a href="#" class="hover:text-white transition-colors">Payment Partners</a>
          <a href="#" class="hover:text-white transition-colors">Security Policy</a>
        </div>
      </div>
    </div>
  </footer>

</body>
</html>
