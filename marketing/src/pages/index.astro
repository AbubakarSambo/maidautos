---
const APP_URL = "https://app.maidautos.com"
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MaidAutos — Safe, Comfortable Intercity Travel in Nigeria</title>
  <meta name="description" content="Book intercity bus tickets across Nigeria. Abuja, Kaduna, Maiduguri and more. Safe, comfortable, on time." />
  <style>
    @import "tailwindcss";
  </style>
</head>
<body class="bg-white text-gray-900 font-sans">

  <!-- Nav -->
  <nav class="flex items-center justify-between px-6 lg:px-16 py-4 border-b">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center">
        <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8M8 11h8M8 15h4m-9 5h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </div>
      <span class="font-bold text-lg">MaidAutos</span>
    </div>
    <a href={APP_URL} class="bg-green-600 text-white px-5 py-2 rounded-full text-sm font-semibold hover:bg-green-700 transition-colors">Book a Ride</a>
  </nav>

  <!-- Hero -->
  <section class="bg-gradient-to-br from-green-900 to-green-700 text-white px-6 lg:px-16 py-24 lg:py-32">
    <div class="max-w-3xl mx-auto text-center">
      <h1 class="text-4xl lg:text-6xl font-bold mb-6 leading-tight">Travel Between Cities<br/>With Confidence</h1>
      <p class="text-green-200 text-lg lg:text-xl mb-10 max-w-xl mx-auto">Book your intercity bus ticket online in minutes. Pay securely, receive your ticket instantly, and travel comfortably.</p>
      <a href={APP_URL} class="inline-block bg-white text-green-800 px-8 py-4 rounded-2xl text-lg font-bold hover:bg-green-50 transition-colors shadow-lg">
        Book Your Ticket Now →
      </a>
    </div>
  </section>

  <!-- How it works -->
  <section class="px-6 lg:px-16 py-20 max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-4">How It Works</h2>
    <p class="text-gray-500 text-center mb-12">Three simple steps to your seat</p>
    <div class="grid lg:grid-cols-3 gap-8">
      {[
        { n: '1', title: 'Search', desc: 'Enter your origin city, destination, and travel date to see available trips.' },
        { n: '2', title: 'Choose Your Seat', desc: 'Pick your seat on the visual seat map and select your preferred stops.' },
        { n: '3', title: 'Pay & Travel', desc: 'Pay securely via Paystack or cash. Receive your e-ticket instantly.' },
      ].map(({ n, title, desc }) => (
        <div class="text-center">
          <div class="w-14 h-14 bg-green-600 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-4">{n}</div>
          <h3 class="text-xl font-bold mb-2">{title}</h3>
          <p class="text-gray-500">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Routes -->
  <section class="bg-gray-50 px-6 lg:px-16 py-20">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-4">Popular Routes</h2>
      <p class="text-gray-500 text-center mb-12">We cover major routes across Northern Nigeria</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          { from: 'Abuja', to: 'Maiduguri' },
          { from: 'Abuja', to: 'Kaduna' },
          { from: 'Kaduna', to: 'Maiduguri' },
          { from: 'Abuja', to: 'Kano' },
          { from: 'Kano', to: 'Maiduguri' },
          { from: 'Kaduna', to: 'Kano' },
        ].map(({ from, to }) => (
          <a href={APP_URL} class="bg-white rounded-xl border p-4 flex items-center gap-3 hover:border-green-400 hover:shadow-sm transition-all group">
            <span class="font-semibold text-gray-900 group-hover:text-green-700">{from}</span>
            <span class="text-gray-400">→</span>
            <span class="font-semibold text-gray-900 group-hover:text-green-700">{to}</span>
            <span class="ml-auto text-green-600 opacity-0 group-hover:opacity-100 transition-opacity text-sm">Book →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="px-6 lg:px-16 py-20 max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-12">Why MaidAutos?</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {[
        { icon: '🔒', title: 'Secure Payments', desc: 'Powered by Paystack. Your payment is safe.' },
        { icon: '📍', title: 'Live Tracking', desc: 'Know exactly where your bus is on its journey.' },
        { icon: '🎫', title: 'Instant Tickets', desc: 'E-ticket delivered by email and WhatsApp.' },
        { icon: '💺', title: 'Choose Your Seat', desc: 'Pick your preferred seat visually before you pay.' },
      ].map(({ icon, title, desc }) => (
        <div class="text-center p-6 rounded-2xl bg-gray-50">
          <div class="text-4xl mb-3">{icon}</div>
          <h3 class="font-bold text-lg mb-2">{title}</h3>
          <p class="text-gray-500 text-sm">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-green-600 text-white px-6 py-16 text-center">
    <h2 class="text-3xl font-bold mb-4">Ready to travel?</h2>
    <p class="text-green-200 mb-8">Join thousands of passengers who book with MaidAutos every day.</p>
    <a href={APP_URL} class="inline-block bg-white text-green-700 px-8 py-4 rounded-2xl text-lg font-bold hover:bg-green-50 transition-colors">Book Your Ticket →</a>
  </section>

  <!-- Footer -->
  <footer class="px-6 lg:px-16 py-10 border-t text-sm text-gray-500 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 bg-green-600 rounded flex items-center justify-center">
        <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8M8 11h8M8 15h4m-9 5h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </div>
      <span class="font-semibold text-gray-700">MaidAutos</span>
    </div>
    <p>© {new Date().getFullYear()} MaidAutos. All rights reserved.</p>
    <a href={`mailto:hello@maidautos.com`} class="hover:text-green-600">hello@maidautos.com</a>
  </footer>

</body>
</html>
